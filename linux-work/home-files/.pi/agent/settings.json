{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "lastChangelogVersion": "1.6.0",
  "theme": "dracula",
  "hideThinkingBlock": true,
  "tuiMode": "fullscreen",
  "quietStartup": "header",
  "treeFilterMode": "user-only",
  "defaultProjectTrust": "always",
  "editorPaddingX": 1,
  "defaultTools": [
    "+grep",
    "+find",
    "+ls",
    "+codemode"
  ],
  "defaultProvider": "magpie",
  "defaultModel": "claude-opus-5-5",
  "defaultThinkingLevel": "high",
  "enabledModels": [
    "llmintro/*",
    "deepseek/*",
    "magpie/**"
  ],
  "packages": [
    "npm:pi-clean-mode",
    "npm:@tifan/pi-inline-skills",
    "npm:@narumitw/pi-statusline",
    "npm:pi-subagents",
    "npm:pi-lens",
    "npm:pi-web-access",
    "npm:@estebanforge/pi-antigravity-bridge"
  ],
  "extensionChangelogVersions": {
    "{\"source\":\"npm:pi-subagents\",\"scope\":\"user\"}": "0.90.0",
    "{\"source\":\"npm:pi-lens\",\"scope\":\"user\"}": "4.5.2",
    "{\"source\":\"npm:pi-web-access\",\"scope\":\"user\"}": "0.48.0",
    "{\"source\":\"npm:@estebanforge/pi-antigravity-bridge\",\"scope\":\"user\"}": "1.13.3",
    "{\"source\":\"npm:@narumitw/pi-statusline\",\"scope\":\"user\"}": "0.51.2"
  }
}