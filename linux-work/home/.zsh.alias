#-------------------- basic --------------------
alias "nv"="nvim"
alias "tm"="tmux"
alias "ll"="ls -l"
alias "la"="ls -al"
alias "lg"="lazygit"
alias "view"="nvim -R"
alias "lc"="leetgo"
alias "rl"="realpath"
alias "ya"="yazi"
alias "op"="opencode"
alias "tc"="tclaude"

#-------------------- agent --------------------
alias "tcd"="IS_SANDBOX=1 tclaude --dangerously-skip-permissions --effort=medium"
alias "ccd"="IS_SANDBOX=1 claude --dangerously-skip-permissions --effort=xhigh"
alias "cbd"="codebuddy --dangerously-skip-permissions"
alias "txd"="tcodex --dangerously-bypass-approvals-and-sandbox"

alias "exp.cc.ds"="source ~/.claude/ds.env"
alias "exp.cc.gpt"="source ~/.claude/gpt.env"
alias "exp.cc.cc"="source ~/.claude/cc.env"

# claude 对话存档:翻篇到下一个 md 文件(配合 func/claude-save.sh 的 Stop hook)
# 用法:在 Claude Code 里两轮之间敲  !cn
alias "cn"="bash ~/.albert-scripts/func/claude-save.sh --next"

#-------------------- td --------------------
alias "td.dotbot"="dotbot -c /data/ws-shared/tdsql-dev-utils/scripts/init/dotbot.yaml"
alias "td.source"="source /data/workspace/tdsql-dev-utils/script/export.sh"
alias "tt"="source /data/ws-shared/tdsql-dev-utils/scripts/export.sh"
alias "tw"="mtr.view"

alias "td.docker.cli"="mycli --host 127.0.0.1 -u root -ppass --port"
alias "t8"="mycli --host 127.0.0.1 -u root -ptdsql2.5 --port 8888"
alias "td.sql"="mysql --comments --host 127.0.0.1 -u root -ptdsql2.5 --port "
alias "td.cli"="mycli --host 127.0.0.1 -u root -ptdsql2.5 --port"
alias "td.cli.mtr"="mycli --host 127.0.0.1 -u test_mtr_1234 -ptest_mtr_1234 --port"

alias "mc25"="v25.mtr.cases"
alias "mc3"="v30.mtr.cases"
alias "mctx"="tx.mtr.cases"
alias "mcdc"="mtr.cases.cdc"

alias "tp1"="tmuxp load -y /data/ws-shared/tdsql-dev-utils/tmuxp/w1.yaml"
alias "tp2"="tmuxp load -y /data/ws-shared/tdsql-dev-utils/tmuxp/w2.yaml"
alias "tp3"="tmuxp load -y /data/ws-shared/tdsql-dev-utils/tmuxp/w3.yaml"
alias "tp.col3"="tmuxp load -y /data/ws-shared/tdsql-dev-utils/tmuxp/col3.yaml"
alias "tp.vt"="tmuxp load -y /data/ws-shared/tdsql-dev-utils/tmuxp/vert.yaml"
alias "tp.vsc"="tmuxp load -y /data/ws-shared/tdsql-dev-utils/tmuxp/vsc.yaml"

alias "tm1"="tmux a -t w1"
alias "tm2"="tmux a -t w2"
alias "tm3"="tmux a -t w3"
alias "tm.vsc"="tmux a -t vsc"
alias "tm.vert"="tmux a -t vert"

#-------------------- fuzzy --------------------
alias "fs"="ab.fs.search"
alias "fj"="ab.fs.jump"
alias "fe"="ab.fs.edit"
alias "fh"="ab.fs.history"
alias "cs"="ab.fs.current.search"
alias "cj"="ab.fs.current.jump"
alias "ce"="ab.fs.current.edit"

#-------------------- dotbot --------------------
alias "dotbot.linux"="cd $HOME/.dotfiles/ && dotbot -c $HOME/.dotfiles/linux-work/dotbot.yaml"

#-------------------- npm --------------------
alias tnpm="npm --registry https://mirrors.tencent.com/npm/"
