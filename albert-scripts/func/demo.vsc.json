{
  "version": "2.0.0",
  "options": {
    "shell": {
      "executable": "/bin/bash",
      "args": [
        "-c"
      ]
    }
  },
  "tasks": [
    {
      "label": "vsc.pick",
      "type": "shell",
      "command": "${env:HOME}/.albert-scripts/bin/vsc-task",
      "args": [
        "vsc.pick.fzf",
        "${workspaceFolder}",
        ".git,.codebuddy,depends,src/duckdb/build"
      ],
      "group": "none",
      "presentation": {
        "echo": false,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "group": "last",
        "close": true
      },
      "problemMatcher": []
    },
    {
      "label": "vsc.get.branch",
      "type": "shell",
      "command": "${env:HOME}/.albert-scripts/bin/vsc-task",
      "args": [
        "vsc.get.branch",
        "${workspaceFolder}"
      ],
      "group": "none",
      "presentation": {
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "group": "last"
      },
      "problemMatcher": []
    },
    {
      "label": "vsc.get.mergebase",
      "type": "shell",
      "command": "${env:HOME}/.albert-scripts/bin/vsc-task",
      "args": [
        "vsc.get.mergebase",
        "${workspaceFolder}",
        "main"
      ],
      "group": "none",
      "presentation": {
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "group": "last",
        "close": true
      },
      "problemMatcher": []
    },
    {
      "label": "vsc.open.plan",
      "type": "shell",
      "command": "${env:HOME}/.albert-scripts/bin/vsc-task",
      "args": [
        "vsc.open.issue",
        "${workspaceFolder}",
        "${workspaceFolder}/note/A-Issue/${workspaceFolderBasename}",
        "plan.md"
      ],
      "group": "none",
      "presentation": {
        "echo": false,
        "reveal": "silent",
        "focus": false,
        "panel": "shared",
        "group": "last"
      },
      "problemMatcher": []
