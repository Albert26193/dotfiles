{
  "version": "2.0.0",
  "options": {
    "shell": {
      "executable": "/bin/bash",
      "args": [
        "-c"
      ]
    }
  },
  "tasks": [
    {
      "label": "vsc.pick",
      "type": "shell",
      "command": "${env:HOME}/.albert-scripts/bin/vsc-task",
      "args": [
        "vsc.pick.fzf",
        "${workspaceFolder}",
        ".git,.codebuddy,depends,src/duckdb/build"
      ],
      "group": "none",
      "presentation": {
        "echo": false,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "group": "last",
        "close": true
      },
      "problemMatcher": []
    },
    {
      "label": "vsc.get.branch",
      "type": "shell",
      "command": "${env:HOME}/.albert-scripts/bin/vsc-task",
      "args": [
        "vsc.get.branch",
        "${workspaceFolder}"
      ],
      "group": "none",
      "presentation": {
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "group": "last"
      },
      "problemMatcher": []
    },
    {
      "label": "vsc.get.mergebase",
      "type": "shell",
      "command": "${env:HOME}/.albert-scripts/bin/vsc-task",
      "args": [
        "vsc.get.mergebase",
        "${workspaceFolder}",
        "main"
      ],
      "group": "none",
      "presentation": {
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "group": "last",
        "close": true
      },
      "problemMatcher": []
    },
    {
      "label": "vsc.open.plan",
      "type": "shell",
      "command": "${env:HOME}/.albert-scripts/bin/vsc-task",
      "args": [
        "vsc.open.at",
        "${workspaceFolder}",
        "{proj}/note/A-Issue/{basename}/{branch}/plan.md"
      ],
      "group": "none",
      "presentation": {
        "echo": false,
        "reveal": "silent",
        "focus": false,
        "panel": "shared",
        "group": "last"
      },
      "problemMatcher": []
    },
    {
      "label": "vsc.touch.pptt",
      "type": "shell",
      "command": "${env:HOME}/.albert-scripts/bin/vsc-task",
      "args": [
        "vsc.touch.pptt",
        "${workspaceFolder}",
        "{proj}/note/A-Issue/{basename}/{branch}"
      ],
      "group": "none",
      "presentation": {
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "group": "last",
        "close": true
      },
      "problemMatcher": []
    },
    {
      "label": "vsc.open.chat",
      "type": "shell",
      "command": "${env:HOME}/.albert-scripts/bin/vsc-task",
      "args": [
        "vsc.open.seq",
        "${workspaceFolder}",
        "{proj}/.ai_dev_chat/{branch}"
      ],
      "group": "none",
      "presentation": {
        "echo": false,
        "reveal": "silent",
        "focus": false,
        "panel": "shared",
        "group": "last"
      },
      "problemMatcher": []
    },
    {
      "label": "vsc.new.chat",
      "type": "shell",
      "command": "${env:HOME}/.albert-scripts/bin/vsc-task",
      "args": [
        "vsc.new.seq",
        "${workspaceFolder}",
        "{proj}/.ai_dev_chat/{branch}"
      ],
      "group": "none",
      "presentation": {
        "echo": false,
        "reveal": "silent",
        "focus": false,
        "panel": "shared",
        "group": "last"
      },
      "problemMatcher": []
    },
    {
      "label": "vsc.open.talk",
      "type": "shell",
      "command": "${env:HOME}/.albert-scripts/bin/vsc-task",
      "args": [
        "vsc.open.seq",
        "${workspaceFolder}",
        "{proj}/.ai_dev_talk/{branch}"
      ],
      "group": "none",
      "presentation": {
        "echo": false,
        "reveal": "silent",
        "focus": false,
        "panel": "shared",
        "group": "last"
      },
      "problemMatcher": []
    },
    {
      "label": "vsc.new.talk",
      "type": "shell",
      "command": "${env:HOME}/.albert-scripts/bin/vsc-task",
      "args": [
        "vsc.new.seq",
        "${workspaceFolder}",
        "{proj}/.ai_dev_talk/{branch}"
      ],
      "group": "none",
      "presentation": {
        "echo": false,
        "reveal": "silent",
        "focus": false,
        "panel": "shared",
        "group": "last"
      },
      "problemMatcher": []
    },
    {
      "label": "vsc.open.iter",
      "type": "shell",
      "command": "${env:HOME}/.albert-scripts/bin/vsc-task",
      "args": [
        "vsc.open.seq",
        "${workspaceFolder}",
        "{proj}/note/A-Issue/{basename}/{branch}/iters",
        "iter-{n}-{topic}.md",
        "# iter-{n}: {topic}"
      ],
      "group": "none",
      "presentation": {
        "echo": false,
        "reveal": "silent",
        "focus": false,
        "panel": "shared",
        "group": "last"
      },
      "problemMatcher": []
    },
    {
      "label": "vsc.new.iter",
      "type": "shell",
      "command": "${env:HOME}/.albert-scripts/bin/vsc-task",
      "args": [
        "vsc.new.seq",
        "${workspaceFolder}",
        "{proj}/note/A-Issue/{basename}/{branch}/iters",
        "iter-{n}-{topic}.md",
        "# iter-{n}: {topic}",
        "${input:iter_topic}"
      ],
      "group": "none",
      "presentation": {
        "echo": false,
        "reveal": "silent",
        "focus": false,
        "panel": "shared",
        "group": "last"
      },
      "problemMatcher": []
    },
    {
      "label": "vsc.ai.dev",
      "type": "shell",
      "command": "${env:HOME}/.albert-scripts/bin/vsc-task",
      "args": [
        "vsc.open.latest",
        "${workspaceFolder}",
        "{proj}/.ai_dev/{branch}"
      ],
      "group": "none",
      "presentation": {
        "echo": false,
        "reveal": "silent",
        "focus": false,
        "panel": "shared",
        "group": "last"
      },
      "problemMatcher": []
    },
    {
      "label": "vsc.ai.chat",
      "type": "shell",
      "command": "${env:HOME}/.albert-scripts/bin/vsc-task",
      "args": [
        "vsc.open.latest",
        "${workspaceFolder}",
        "{proj}/.ai_dev_chat/{branch}"
      ],
      "group": "none",
      "presentation": {
        "echo": false,
        "reveal": "silent",
        "focus": false,
        "panel": "shared",
        "group": "last"
      },
      "problemMatcher": []
    },
    {
      "label": "vsc.open.envsetup",
      "type": "shell",
      "command": "${env:HOME}/.albert-scripts/bin/vsc-task",
      "args": [
        "vsc.open.vscode",
        "${env:HOME}/.vscode-server/server-env-setup"
      ],
      "group": "none",
      "presentation": {
        "echo": false,
        "reveal": "silent",
        "focus": false,
        "panel": "shared",
        "group": "last"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "mtr_work_dir",
      "type": "promptString",
      "description": "mtr worker dir under mysql-test/var",
      "default": "empty"
    },
    {
      "id": "iter_topic",
      "type": "promptString",
      "description": "iter topic (slugified into the file name)",
      "default": "draft"
    }
  ]
}
