#!/bin/bash

# in which dir to search
FS_SEARCH_DIRS=(
  "${HOME}"
  "/data"
  #"CodeSpace"
)

# within search range, which dir to ignore
FS_SEARCH_IGNORE_DIRS=(
  "Downloads"
  "Desktop"
  ".git"
  ".local"
  ".ccls-cache"
  ".ccls"
  ".m2"
  ".gradle"
  ".wns"
  ".nvm"
  ".npm"
  ".nrm"
  ".red-hat"
  ".oh-my-zsh"
  ".github"
  ".gongfeng-copilot"
  ".cache"
  ".cargo"
  ".rustup"
  ".vscode"
  ".vscode-insiders"
  ".vscode-server-insiders"
  ".vscode-server"
  ".vscode-oss"
  ".vscode-oss-insiders"
  "lib"
  "node_modules"
  "pkg"
  "bin"
  "dist"
  "pkgs"
  "from-github"
  "assets"
  "image"
  "images"
  "static"
  "data"
  "raycast"
  "zlt-*"
  "anaconda3"
  "miniconda3"
  "Applications"
  "Library"
  "Movies"
  "Music"
  "Pictures"
  "Public"
  "Remote"
  "Zotero"
  "EVPlayer2_download"
)

# search preview or not, true: preview | false: not preview
# if your machine is not powerful enough(RAM <= 1GiB), set it to false
# otherwise, set it to true(Recommend)
FS_SEARCH_PREVIEW=true
# FS_SEARCH_PREVIEW=false

# FS_EDITOR="vim"
FS_EDITOR="nvim"

# whether to cd into the file's parent directory before editing
# true: cd to file's directory then edit (default)
# false: open file directly with full/relative path, stay in current directory
FS_EDIT_CD=false

ALBERT_SCRIPTS_PATH="${HOME}/.albert-scripts"
