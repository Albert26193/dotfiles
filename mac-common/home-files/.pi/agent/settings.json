{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "lastChangelogVersion": "1.6.0",
  "theme": "dracula",
  "hideThinkingBlock": true,
  "tuiMode": "fullscreen",
  "quietStartup": "header",
  "treeFilterMode": "user-only",
  "defaultProjectTrust": "always",
  "editorPaddingX": 1,
  "defaultTools": [
    "+grep",
    "+find",
    "+ls",
    "+codemode"
  ],
  "defaultProvider": "deepseek",
  "defaultModel": "deepseek-flash",
  "defaultThinkingLevel": "high",
  "enabledModels": [
    "llmintro/*",
    "deepseek/*",
    "magpie/*"
  ],
  "packages": [
    "npm:pi-clean-mode",
    "npm:@tifan/pi-inline-skills",
    "npm:@narumitw/pi-statusline",
    "npm:pi-subagents",
    "npm:pi-lens",
    "npm:pi-web-access"
  ],
  "extensionChangelogVersions": {
    "{\"source\":\"npm:pi-subagents\",\"scope\":\"user\"}": "0.84.0",
    "{\"source\":\"npm:pi-lens\",\"scope\":\"user\"}": "4.4.7",
    "{\"source\":\"npm:pi-web-access\",\"scope\":\"user\"}": "0.46.0"
  }
}