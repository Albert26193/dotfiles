#-------------------- basic --------------------
alias "nv"="nvim"
alias "tm"="tmux"
alias "ll"="ls -l"
alias "la"="ls -al"
alias "lg"="lazygit"
alias "view"="nvim -R"
alias "lc"="leetgo"
alias "rl"="realpath"

#-------------------- fuzzy --------------------
alias "fs"="ab.fs.search"
alias "fj"="ab.fs.jump"
alias "fe"="ab.fs.edit"
alias "fh"="ab.fs.history"
alias "cs"="ab.fs.current.search"
alias "cj"="ab.fs.current.jump"
alias "ce"="ab.fs.current.edit"

#-------------------- cc --------------------
alias "ccd"="IS_SANDBOX=1 claude --dangerously-skip-permissions"
alias "exp.cc.cc"="source ~/.claude/cc.env"
alias "exp.cc.ds"="source ~/.claude/ds.env"
alias "exp.cc.gpt"="source ~/.claude/gpt.env"
alias "exp.cc.kimi"="source ~/.claude/kimi.env"
alias "exp.cc.antigravity"="source ~/.claude/antigravity.env"

#-------------------- export --------------------
alias exp.mysql.sh="export MYSQL_PWD=$mysql_pwd_sh"
alias exp.mysql.local="export MYSQL_PWD=$mysql_pwd_local"

#-------------------- chrome --------------------
alias chrome="/Applications/Google\ Chrome.app/Contents/MacOS/Google\ Chrome"

#--------------------- autossh --------------------
alias "assh"="autossh -M 0"

