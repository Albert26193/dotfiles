{
  /**********************************/
  /*********** Codebuddy ************/
  /**********************************/
  "codingcopilot.enableInlineChat": true,
  "codingcopilot.enableInlineChatIDEShortcutsTip": false,
  "codingcopilot.commitMessageStyle": "Auto",
  "codingcopilot.commitMessageLanguage": "en",
  "codingcopilot.toolbarOnSelection": false,
  "codingcopilot.enableAutoCompletions": true,
  /**********************************/
  /*********** Languages ************/
  /**********************************/
  "[astro]": {
    "editor.defaultFormatter": "astro-build.astro-vscode"
  },
  "[cpp]": {
    "editor.defaultFormatter": "xaver.clang-format",
    "editor.formatOnSaveMode": "modifications",
    // "editor.formatOnSave": false,
    "files.insertFinalNewline": false,
    "files.trimTrailingWhitespace": false,
    "editor.tabSize": 2,
    "editor.indentSize": "tabSize",
    "editor.insertSpaces": true,
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 300
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[go]": {
    "editor.defaultFormatter": "golang.go",
    "editor.formatOnSave": true,
    "editor.tabSize": 4
  },
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features"
  },
  "[javascript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
    "editor.indentSize": "tabSize",
    "editor.insertSpaces": true
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[properties]": {
    // "editor.defaultFormatter": "foxundermoon.shell-format"
  },
  "[python]": {
    "editor.defaultFormatter": "ms-python.python",
    "editor.formatOnType": true
  },
  "[rust]": {
    "editor.defaultFormatter": "jinxdash.prettier-rust",
    "editor.formatOnSave": false,
    "editor.tabSize": 2
  },
  "[scss]": {
    "editor.defaultFormatter": "vscode.css-language-features"
  },
  "[shellscript]": {
    "editor.defaultFormatter": "mads-hartmann.bash-ide-vscode",
    "editor.detectIndentation": true,
    "editor.insertSpaces": true,
    "editor.tabSize": 2
  },
  "[sql]": {
    "editor.defaultFormatter": "inferrinizzard.prettier-sql-vscode",
    "editor.formatOnPaste": false,
    "editor.formatOnSave": false,
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 300,
    "editor.commentStart": "# ",
    "editor.commentEnd": ""
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[vue]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[yaml]": {
    "diffEditor.ignoreTrimWhitespace": true
  },
  /**********************************/
  /*********** chatgpt **************/
  /**********************************/
  "chatgpt.openOnStartup": true,
  "chatgpt.commentCodeLensEnabled": false,
  "chatgpt.composerEnterBehavior": "enter",
  /**********************************/
  /*********** bash-ide ************/
  /**********************************/
  //  "bashIde.shfmt.path": "/root/go/bin/shfmt",
  /**********************************/
  /*********** bookmarks ************/
  /**********************************/
  "bookmarks.gutterIconBorderColor": "#15FE7B",
  "bookmarks.gutterIconFillColor": "#15FE7B",
  // "bookmarks.navigateThroughAllFiles": true,
  "bookmarks.navigateThroughAllFiles": false,
  "bookmarks.saveBookmarksInProject": true,
  "bookmarks.sideBar.expanded": true,
  /**********************************/
  /************* C/C++ *************/
  "C_Cpp.autocomplete": "disabled",
  "C_Cpp.formatting": "disabled",
  "C_Cpp.errorSquiggles": "disabled",
  "C_Cpp.intelliSenseEngine": "disabled",
  /**********************************/
  /**********************************/
  /************* clangd *************/
  /**********************************/
  "clangd.arguments": [
    // auto analyze files in background (based on compile_commands)
    "--background-index",
    // compile_commands.json directory path
    "--compile-commands-dir=build",
    // max concurrent tasks
    "-j=64",
    // which clang to use, path from `which clang++`
    "--query-driver=/usr/bin/clang++",
    // clang-tidy feature
    "--clang-tidy=false",
    // "--clang-tidy-checks=performance-*,bugprone-*",
    "--clang-tidy-checks=-*",
    // global completion (auto include headers)
    "--all-scopes-completion",
    // more detailed completion
    "--completion-style=detailed",
    // header insertion style
    "--header-insertion=iwyu",
    // pch storage location
    "--pch-storage=disk"
    // resoure-dir
  ],
  /**********************************/
  /********* clang-tidy *************/
  /**********************************/
  "clang-tidy.executable": "/usr/bin/clang-tidy",
  "clang-tidy.compilerArgsBefore": [],
  // "clang-tidy.buildPath": "TDProxyEngine/tdsql/bld",
  "clang-tidy.lintOnSave": false,
  /**********************************/
  /************* ccls **************/
  /**********************************/
  "ccls.highlight.rainbow": 10,
  "ccls.launch.args": [
    // add log file output
    "-log-file=/tmp/ccls_vscode.log",
    // disable ccls folding, native folding is better
    "--init={\"capabilities\": {\"foldingRangeProvider\": false}}"
  ],
  "ccls.clang.extraArgs": [
    // "-Wall",
    "-Wunused-variable",
    "-Wno-error=unused-variable",
  ],
  "ccls.completion.detailedLabel": true,
  "ccls.completion.caseSensitivity": 1,
  "ccls.completion.duplicateOptional": true,
  "ccls.completion.enableSnippetInsertion": false,
  "ccls.codeLens.enabled": false,
  // "ccls.cache.fullLoadOnInitialize": false,
  // "ccls.codeLens.enabled": false,
  // "ccls.codeLens.renderInline": true,
  /**********************************/
  /************** cmake *************/
  /**********************************/
  "cmake.buildDirectory": "${workspaceFolder}/build/debug",
  "cmake.configureOnOpen": false,
  "cmake.pinnedCommands": [
    "workbench.action.tasks.configureTaskRunner",
    "workbench.action.tasks.runTask"
  ],
  /**********************************/
  /********** code-runner ***********/
  /**********************************/
  "code-runner.executorMap": {
    "cpp": "cd $dir && g++ -std=c++17 $fileName -o $fileNameWithoutExt && $dir$fileNameWithoutExt"
  },
  "code-runner.runInTerminal": true,
  "code-runner.saveAllFilesBeforeRun": true,
  "code-runner.saveFileBeforeRun": true,
  /**********************************/
  /************* cSpell *************/
  /**********************************/
  "cSpell.caseSensitive": true,
  "cSpell.checkLimit": 100000000,
  "cSpell.checkOnlyEnabledFileTypes": false,
  "cSpell.diagnosticLevel": "Hint",
  /**********************************/
  /************* debug **************/
  /**********************************/
  "debug.inlineValues": "off",
  "debug.internalConsoleOptions": "openOnSessionStart",
  "debug.onTaskErrors": "abort",
  "debug.openDebug": "openOnSessionStart",
  "debug.showBreakpointsInOverviewRuler": true,
  "debug.showInStatusBar": "always",
  "debug.toolBarLocation": "commandCenter",
  "debug.console.wordWrap": true,
  /***************************************/
  /************* diffEditor **************/
  /***************************************/
  "diffEditor.ignoreTrimWhitespace": false,
  "diffEditor.wordWrap": "on",
  "diffEditor.hideUnchangedRegions.enabled": true,
  /**********************************/
  /************* editor *************/
  /**********************************/
  "editor.acceptSuggestionOnCommitCharacter": true,
  "editor.acceptSuggestionOnEnter": "on",
  "editor.accessibilitySupport": "off",
  "editor.aiStats.enabled": true,
  "editor.autoClosingBrackets": "languageDefined",
  "editor.autoIndent": "advanced",
  "editor.foldingHighlight": true,
  // "editor.largeFileOptimizations": true,
  "editor.largeFileOptimizations": false,
  "editor.lightbulb.enabled": "off",
  "editor.lineHeight": 1.75,
  "editor.minimap.enabled": false,
  "editor.semanticHighlighting.enabled": true,
  "editor.suggest.localityBonus": true,
  "editor.tabCompletion": "on",
  "editor.autoSurround": "languageDefined",
  "editor.bracketPairColorization.enabled": true,
  "editor.codeActionsOnSave": {
    "source.fixAll": "never"
  },
  "editor.cursorBlinking": "solid",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorStyle": "line",
  "editor.cursorSurroundingLines": 5,
  "editor.detectIndentation": true,
  "editor.find.globalFindClipboard": false,
    // "editor.find.addExtraSpaceOnTop": true,
    "editor.find.addExtraSpaceOnTop": false,
    "editor.find.seedSearchStringFromSelection": "selection",
    "editor.find.autoFindInSelection": "multiline",
    // "editor.find.findOnType": false,
    // Chinese fonts support
    "editor.fontFamily": "'Iosevka SS16 Light', 'Iosevka SS05 Light', 'Sarasa Mono SC Light', 'ZhuqueFangsong-Regular', 'Alibaba PuHuiTi 3.0'",
  "editor.fontSize": 13,
  "editor.fontLigatures": true,
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "modificationsIfAvailable",
  "editor.guides.bracketPairs": true,
  "editor.guides.bracketPairsHorizontal": true,
  "editor.guides.highlightActiveIndentation": true,
  "editor.guides.indentation": true,
  "editor.hideCursorInOverviewRuler": false,
  "editor.indentSize": "tabSize",
  "editor.inlayHints.enabled": "on",
  "editor.inlineSuggest.enabled": false,
  "editor.insertSpaces": true,
  "editor.lineNumbers": "relative",
  "editor.minimap.autohide": "mouseover",
  "editor.minimap.sectionHeaderFontSize": 10,
  "editor.overviewRulerBorder": false,
  "editor.parameterHints.enabled": true,
  "editor.suggest.snippetsPreventQuickSuggestions": false,
  "editor.snippetSuggestions": "top",
  "editor.parameterHints.cycle": true,
  "editor.quickSuggestionsDelay": 2,
  "editor.renderWhitespace": "trailing",
  "editor.renderLineHighlight": "gutter",
  "editor.rulers": [
    80
  ],
  "editor.scrollbar.vertical": "hidden",
  "editor.scrollBeyondLastLine": true,
  "editor.tokenColorCustomizations": {
    "[*Solarized*]": {
      "textMateRules": [
        {
          "scope": [
            "keyword.control.directive.conditional.ifndef.cpp",
            "keyword.control.directive.endif.cpp"
          ],
          "settings": {
            "foreground": "#6d71c4",
            "fontStyle": "bold" // optional: bold
          }
        }
      ]
    }
  },
  "editor.semanticTokenColorCustomizations": {
    // "[Solarized Osaka]": {
    //   "rules": {
    //     "class:cpp": {
    //       "foreground": "#4faff3"
    //     },
    //     "field:cpp": {
    //       "foreground": "#81bc7fe6"
    //     },
    //     "function": {
    //       "foreground": "#ff93c7df"
    //     },
    //     "macro": "#6d71c4",
    //     "struct": "#4faff3",
    //     "method": {
    //       "foreground": "#ddb383e6"
    //     },
    //     "*.static:cpp": {
    //       "foreground": "#b58900",
    //       "fontStyle": "italic"
    //     },
    //   }
    // },
    "[*Solarized*]": {
      "rules": {
        // "editorWhitespace.foreground": "#2d2d2d00",
        // "editorWhitespace.background": "#0b0b0b00",
        "enum:cpp": {
          "foreground": "#829703"
        },
        "enumMember:cpp": {
          "foreground": "#829703"
        },
        "class:cpp": {
          "foreground": "#82bbeadf"
        },
        "field:cpp": {
          "foreground": "#81bc7fe6"
        },
        "function": {
          "foreground": "#ff93c7cf"
          // "foreground": "#ffb6c1dd"
        },
        "parameter:cpp": {
          "foreground": "#cb4b16"
        },
        "macro": "#6d71c4",
        "struct": "#5ffffc92",
        "method": {
          // "foreground": "#ddb383e6"
          "foreground": "#ddb383dd"
        },
        "*.static:cpp": {
          "foreground": "#b58900",
          "fontStyle": "italic"
        },
        "namespace": "#288bd2",
        "typeAlias:cpp": {
          "foreground": "#288bd2"
        },
        "variable": {
          "foreground": "#aeb8b8e0"
          // "foreground": "#9facaddd"
        },
      }
    },
    "[One Monokai]": {
      "rules": {
        "field:cpp": {
          "foreground": "#8ab6dcd7"
        },
        "function": {
          // "foreground": "#b5bd00"
          "foreground": "#ffb6c1"
          // "foreground": "#eee383cc"
          // "foreground": "#ffae51cc"
        },
        "macro": "#ff95f6cd",
      },
    }
  },
  "editor.suggest.showCustomcolors": true,
  "editor.showFoldingControls": "always",
  "editor.smoothScrolling": true,
  "editor.stickyScroll.defaultModel": "outlineModel",
  // "editor.stickyScroll.defaultModel": "foldingProviderModel",
  "editor.stickyScroll.enabled": true,
  "editor.stickyScroll.maxLineCount": 8,
  "editor.stickyScroll.scrollWithEditor": true,
  // "editor.suggest.preview": false,
  "editor.suggest.preview": true,
  "editor.tabSize": 2,
  "editor.wordSeparators": "/\\()\"':,.;<>~!@#$%^&*|+=[]{}`?-",
  "editor.wordWrap": "off",
  // "editor.wordWrap": "on",
  "editor.wordWrapColumn": 120,
  /**********************************/
  /*********** errorLens ************/
  /**********************************/
  "errorLens.enabledDiagnosticLevels": [
    "error",
    "warning"
  ],
  /**********************************/
  /*********** explorer *************/
  /**********************************/
  "explorer.compactFolders": false,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  /**********************************/
  /********** extensions ************/
  /**********************************/
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1
    // "vscodeVim.vim": 1
  },
  "extensions.ignoreRecommendations": true,
  /**********************************/
  /************* files **************/
  /**********************************/
  "files.associations": {
    "*.0": "log",
    "*.custom": "makefile",
    "*.err": "log",
    "*.result": "sql",
    "*.test": "sql",
    "**/*.cnf": "ini",
    "**/*.inc": "sql",
    "**/*.test": "sql",
    "Dockerfile-private": "dockerfile",
    "*.case-2": "log",
    "*.log": "log",
    "*.txt": "log",
    "*.hg": "log",
    "*.tdsql": "log"
  },
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 300,
  "files.exclude": {
    "**/.DS_Store": false,
    "**/.git": false,
    "out": false
  },
  "files.insertFinalNewline": true,
  // "files.encoding": "windows1252", // Replace with your desired non-UTF-8 encoding
  "files.autoGuessEncoding": false,
  /**********************************/
  /********* find-it-faster *********/
  /**********************************/
  "find-it-faster.general.killTerminalAfterUse": true,
  "find-it-faster.general.useTerminalInEditor": true,
  "find-it-faster.general.useWorkspaceSearchExcludes": true,
  "find-it-faster.general.hideTerminalAfterSuccess": true,
  "find-it-faster.general.additionalSearchLocations": [
    "/data/workspace/TDProxyEngine/sql"
  ],
  "find-it-faster.findWithinFiles.fuzzRipgrepQuery": true,
  /**********************************/
  /*********** git-graph ************/
  /**********************************/
  "git-graph.maxDepthOfRepoSearch": 1,
  /**********************************/
  /************** git ***************/
  /**********************************/
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "git.ignoreLegacyWarning": true,
  "scm.repositories.selectionMode": "multiple",
  /**********************************/
  /********* github.copilot *********/
  /**********************************/
  "inlineChat.lineNaturalLanguageHint": false,
  "github.copilot.chat.edits.temporalContext.enabled": true,
  "github.copilot.chat.agent.currentEditorContext.enabled": true,
  "github.copilot.chat.scopeSelection": true,
  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
    "cpp": false,
    "shellscript": true,
    "sql": true
  },
  "github.copilot.nextEditSuggestions.enabled": true,
  "github.copilot.chat.editor.temporalContext.enabled": true,
  "github.copilot.chat.agent.thinkingTool": true,
  "github.copilot.chat.codeGeneration.useInstructionFiles": true,
  "github.copilot.chat.edits.suggestRelatedFilesForTests": true,
  "github.copilot.chat.edits.suggestRelatedFilesFromGitHistory": true,
  "github.copilot.chat.codesearch.enabled": true,
  "github.copilot.chat.terminalChatLocation": "chatView",
  "github.copilot.chat.alternateGptPrompt.enabled": true,
  "github.copilot.chat.enableRetryAfterFilteredResponse": true,
  "github.copilot.chat.commitMessageGeneration.instructions": [
    {
      "file": ".github/git/commit.instructions.md"
    }
  ],
  "chat.mcp.access": "all",
  "chat.agent.maxRequests": 300,
  "chat.editing.confirmEditRequestRemoval": false,
  "chat.tools.terminal.autoApprove": {
    "grep": true,
    "rg": true,
    "find": true,
    "fd": true,
    "cd": true,
    "nl": true,
    "sed": true,
    "bison": true
  },
  "chat.agentSessionsViewLocation": "view",
  "chat.agent.enabled": true,
  "chat.mcp.autostart": "newAndOutdated",
  /**********************************/
  /************ gitlens *************/
  /**********************************/
  "gitlens.views.commitDetails.files.layout": "tree",
  "gitlens.advanced.messages": {
    "suppressGitVersionWarning": true
  },
  "gitlens.autolinks": [
    {
      "prefix": "#",
      "url": "https://git.woa.com/tdsql_proj/TDProxyEngine/-/merge_requests?state=all&sort=created_desc&page=1&per_page=20&search=<num>"
    },
    {
      "prefix": "!",
      "url": "https://git.woa.com/tdsql_proj/TDProxyEngine/merge_requests/<num>"
    }
  ],
  "gitlens.fileAnnotations.dismissOnEscape": false,
  "gitlens.views.commits.avatars": false,
  "gitlens.views.scm.grouped.views": {
    "commits": true,
    "branches": true,
    "remotes": true,
    "stashes": true,
    "tags": true,
    "worktrees": true,
    "contributors": true,
    "fileHistory": false,
    "repositories": true,
    "searchAndCompare": true,
    "launchpad": false
  },
  "gitlens.views.showRelativeDateMarkers": false,
  /**********************************/
  /************** log ***************/
  /**********************************/
  "logFileHighlighter.progressIndicatorUnderlineColor": "#00ff1f8f",
  "logFileHighlighter.customPatterns": [
    {
      "pattern": "(error(^_))",
      "foreground": "#ff0000",
      "wholeLine": true
    },
    {
      "pattern": "\\[ERROR\\]",
      "background": "#ff1764",
      "foreground": "#0c0c0c",
      "wholeLine": true
    },
    {
      "pattern": "marker_",
      "background": "#80ceffbe",
      "foreground": "#000000",
      "wholeLine": true
    },
    {
      "pattern": "(\\[DEBUG\\])",
      "foreground": "#80ceff",
      "wholeLine": true
    },
    {
      "pattern": "(kkkick|Fail|FAIL|fail|kick)",
      "foreground": "#e600ff",
      "wholeLine": true
    },
    {
      "pattern": "(errmsg:)",
      "background": "#f6a0ff",
      "foreground": "#0c0c0c",
      "wholeLine": true
    },
    {
      "pattern": "(_execute_local_with_version)",
      "background": "#0088b1",
      "foreground": "#0c0c0c",
      "wholeLine": true
    },
    {
      "pattern": "(\\;)",
      "foreground": "#00d5ff",
      "wholeLine": true
    },
    {
      "pattern": "(schema_name:|resource_name:|exclusive_resources)",
      "foreground": "#ffff00"
    },
    {
      "pattern": "(,sql:| sql: /\\*.*\\*\\/|rewritten_sql| sql:|sql= |sql=/\\*.*\\*\\/)",
      "foreground": "#ffff00"
    },
    {
      "pattern": "(DDL|\\[ddl:/\\*.*\\*/\\]|ddl json info:|ddl:)",
      "foreground": "#00ffcc"
      // "background": "#00ffcc",
      // "foreground": "#0c0c0c"
    },
    {
      "pattern": "(success|SUCCESS|Success|succeed|Succeed| ON COMPLETED|COMPLETED|LogDdlStepCost)",
      "foreground": "#00ff4c"
    },
    {
      "pattern": "(?<=level:\\s*)debug",
      "foreground": "#0000ff",
      "flags": "i"
    }
  ],
  /**********************************/
  /*************** go ***************/
  /**********************************/
  "go.alternateTools": {
    "experimentalWorkspaceModule": true
  },
  "go.lintOnSave": "file",
  "go.toolsManagement.autoUpdate": true,
  "go.vetOnSave": "off",
  /**********************************/
  /************ gongfeng ************/
  /**********************************/
  "gongfeng.copilot.commitMessageSuggestTAPD": true,
  "gongfeng.copilot.enableAutoCompletions": false,
  "gongfeng.copilot.floatShortcut": true,
  "gongfeng.copilot.enableSmartAdaptiveCompletionSpeed": false,
  "gongfeng.copilot.enableNextEditSuggestions": false,
  "gongfeng.copilot.enableCloseCompletionShortcutTip": false,
  "gongfeng.copilot.enableCodelensForComments": false,
  "gongfeng.copilot.commitMessageLanguage": "English",
  /**********************************/
  /************** html **************/
  /**********************************/
  "html.format.wrapAttributes": "force",
  /**********************************/
  /********** indenticator **********/
  /**********************************/
  "indenticator.color.dark": "#efefef",
  "indenticator.hover.trimLinesShorterThan": 0,
  "indenticator.languageSpecific": {},
  "indenticator.showCurrentDepthInStatusBar": true,
  "indenticator.showIndentGuide": true,
  "indenticator.width": 1.2,
  /**********************************/
  /********* indentRainbow **********/
  /**********************************/
  "indentRainbow.lightIndicatorStyleLineWidth": 0,
  "indentRainbow.indicatorStyle": "classic",
  /**********************************/
  /********** javascript ************/
  /**********************************/
  "javascript.updateImportsOnFileMove.enabled": "always",
  "javascript.suggest.paths": false,
  /**********************************/
  /************ makefile ************/
  /**********************************/
  "makefile.configureOnOpen": true,
  /**********************************/
  /*********** notebook *************/
  /**********************************/
  "notebook.lineNumbers": "on",
  "notes.notesLocation": "/data/workspace/note",
  /**********************************/
  /********* Prettier-SQL ***********/
  /**********************************/
  "Prettier-SQL.commaPosition": "after",
  "Prettier-SQL.expressionWidth": 120,
  "Prettier-SQL.indentStyle": "standard",
  "Prettier-SQL.keywordCase": "upper",
  "Prettier-SQL.linesBetweenQueries": 1,
  "Prettier-SQL.newlineBeforeSemicolon": false,
  "Prettier-SQL.denseOperators": false,
  "Prettier-SQL.logicalOperatorNewline": "before",
  "Prettier-SQL.tabulateAlias": true,
  /**********************************/
  /************ prettier ************/
